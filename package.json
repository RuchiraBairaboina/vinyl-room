{
  "name": "vinyl-room",
  "version": "1.0.0",
  "private": true,
  "description": "A cozy, interactive vinyl listening room — React + Node.js, powered by Spotify embeds",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --watch server/index.js\" \"vite client\"",
    "build": "vite build client",
    "start": "node server/index.js",
    "test": "node --test \"server/tests/*.test.js\" \"client/src/lib/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.0"
  }
}
